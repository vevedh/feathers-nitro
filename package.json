{
  "name": "@vevedh/feathers-nitro",
  "type": "module",
  "version": "0.6.0",
  "packageManager": "pnpm@10.34.5",
  "description": "FeathersJS integration for Nuxt/Nitro with Express, Koa, Socket.IO, and multi-instance support",
  "author": "vevedh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vevedh/feathers-nitro.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "nuxt",
    "nitro",
    "nitro-plugin",
    "feathers",
    "feathersjs",
    "express",
    "expressjs",
    "koa",
    "koajs",
    "socket.io"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./routers": {
      "types": "./dist/runtime/routers/index.d.ts",
      "import": "./dist/runtime/routers/index.mjs",
      "require": "./dist/runtime/routers/index.cjs"
    },
    "./plugins": {
      "types": "./dist/runtime/plugins/index.d.ts",
      "import": "./dist/runtime/plugins/index.mjs",
      "require": "./dist/runtime/plugins/index.cjs"
    },
    "./handlers": {
      "types": "./dist/runtime/handlers/index.d.ts",
      "import": "./dist/runtime/handlers/index.mjs",
      "require": "./dist/runtime/handlers/index.cjs"
    },
    "./setup": {
      "types": "./dist/runtime/setup.d.ts",
      "import": "./dist/runtime/setup.mjs",
      "require": "./dist/runtime/setup.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "unbuild",
    "dev:nuxt": "pnpm --filter nuxt-app dev",
    "stackblitz:bootstrap": "node scripts/stackblitz-bootstrap.mjs",
    "dev:api": "pnpm --filter feathers-api dev",
    "prerelease": "pnpm check:runtime && pnpm check:identity && pnpm check:portability && pnpm check:feathers-suite && pnpm check:stackblitz && pnpm check:nuxt-stack && pnpm check:release && pnpm test:types && pnpm lint && pnpm test:all",
    "release": "release-it",
    "lint": "pnpm lint:root && pnpm lint:workspaces",
    "lint:fix": "pnpm lint:root:fix && pnpm lint:workspaces:fix",
    "test": "node scripts/run-vitest-suite.mjs",
    "test:all": "pnpm --dir playground/feathers-api test && pnpm test",
    "test:watch": "vitest watch test/*",
    "test:types": "vue-tsc --noEmit && pnpm --dir playground/feathers-api exec tsc --noEmit && pnpm --dir playground/nuxt-app exec vue-tsc --noEmit",
    "cleanup": "nuxi cleanup",
    "prepare": "nuxi prepare && nitro prepare",
    "release:dry-run": "release-it --dry-run",
    "check:identity": "node scripts/check-package-identity.mjs",
    "deps:check": "taze",
    "deps:check:recursive": "taze -r",
    "deps:update:safe": "taze minor -w --maturity-period 14",
    "deps:update:safe:recursive": "taze minor -r -w --maturity-period 14",
    "deps:update:major:review": "taze major -r",
    "verify": "pnpm check:runtime && pnpm check:identity && pnpm check:portability && pnpm check:feathers-suite && pnpm check:test-runner && pnpm check:stackblitz && pnpm check:nuxt-stack && pnpm check:release && pnpm test:types && pnpm lint && pnpm test:all && pnpm pack:check && pnpm check:artifact",
    "lint:workspaces": "pnpm --dir playground/feathers-api exec eslint . && pnpm --dir playground/nuxt-app prepare && pnpm --dir playground/nuxt-app exec eslint .",
    "lint:workspaces:fix": "pnpm --dir playground/feathers-api exec eslint . --fix && pnpm --dir playground/nuxt-app prepare && pnpm --dir playground/nuxt-app exec eslint . --fix",
    "pack:check": "pnpm pack --pack-destination .pack-check",
    "check:portability": "node scripts/check-lockfile-portability.mjs",
    "lint:root": "eslint --config eslint.config.mjs eslint.config.mjs nitro.config.ts taze.config.js scripts src test",
    "lint:root:fix": "eslint --config eslint.config.mjs eslint.config.mjs nitro.config.ts taze.config.js scripts src test --fix",
    "check:test-runner": "node scripts/check-vitest-retry.mjs",
    "check:tooling-bridge": "pnpm check:nuxt-stack",
    "check:feathers-suite": "node scripts/check-feathers-suite.mjs",
    "check:stackblitz": "node scripts/check-stackblitz-config.mjs",
    "check:runtime": "node scripts/check-node-runtime.mjs",
    "check:nuxt-stack": "node scripts/check-nuxt-stack.mjs",
    "check:release": "node scripts/check-release-readiness.mjs",
    "test:showcase": "vitest run test/playground-showcase.test.ts --maxWorkers=1 --no-file-parallelism",
    "check:artifact": "node scripts/check-packed-artifact.mjs",
    "release:certify": "pnpm verify && pnpm publish:dry-run",
    "publish:dry-run": "npm publish --dry-run --access public --registry=https://registry.npmjs.org/"
  },
  "dependencies": {
    "@feathersjs/errors": "^5.0.49",
    "@feathersjs/express": "^5.0.49",
    "@feathersjs/feathers": "^5.0.49",
    "@feathersjs/koa": "^5.0.49",
    "@feathersjs/socketio": "^5.0.49",
    "engine.io": "^6.6.9",
    "express": "^4.22.2",
    "h3": "1.15.11",
    "nitropack": "2.13.4"
  },
  "devDependencies": {
    "@gabortorma/antfu-eslint-config": "3.2.0",
    "@gabortorma/nuxt-eslint-layer": "1.0.0",
    "@nuxt/schema": "4.5.2",
    "@nuxt/test-utils": "4.2.0",
    "@types/koa": "^3.0.3",
    "@types/node": "^22.20.0",
    "eslint": "9.39.5",
    "nuxi": "3.37.0",
    "nuxt": "4.5.2",
    "release-it": "20.2.0",
    "rolldown": "1.2.4",
    "taze": "19.14.1",
    "typescript": "5.9.3",
    "unbuild": "3.6.1",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue": "3.5.42",
    "vue-tsc": "3.3.11"
  },
  "pnpm": {
    "updateConfig": {
      "ignoreDependencies": [
        "h3",
        "nitropack"
      ]
    },
    "overrides": {
      "rolldown": "1.2.4",
      "vite": "8.2.2",
      "vue": "3.5.42"
    }
  },
  "contributors": [
    "Gabor Torma (original author)"
  ],
  "homepage": "https://github.com/vevedh/feathers-nitro#readme",
  "bugs": {
    "url": "https://github.com/vevedh/feathers-nitro/issues"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  }
}
